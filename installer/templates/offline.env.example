# ==============================================================================
# 产线缺陷在线AI检测系统 —— 离线部署口令文件（模板）
#
# 用法（只在"无外网离线交付"时需要）：
#   1. 把本文件复制为同目录的 offline.env：
#        cp config/offline.env.example config/offline.env
#   2. 填入本次交付的实际口令，去掉 <> 占位尖括号。
#   3. 部署：sudo bash scripts/deploy.sh --offline --disk /dev/sdb --yes
#
# deploy.sh 会自动读取 config/offline.env，作为 MySQL root 口令与管理员口令来源。
# 口令优先级：命令行 --db-password/--app-password > 环境变量 > 本文件 > /etc/default > 交互。
#
# 安全提醒：
#   - 本文件含明文口令，权限建议 chmod 600，仅在交付/部署期间保留。
#   - 部署完成后，口令已写入服务器 /etc/default/camera-detection（640 root），
#     可从发布目录删除 offline.env，避免随包流传。
#   - offline.env 已被 .gitignore 排除，不会进 git 仓库；但会随 offline.env.example
#     一起被打进发布包 —— 切勿把填好的真实口令文件提交到任何版本库。
# ==============================================================================

# MySQL root 口令（应用以 root 连接本机库）
MYSQL_PASSWORD='<请填写数据库root口令>'

# 管理员 admin 的新口令（p7 会真正落库，不再是种子弱口令）
ADMIN_PASSWORD='<请填写管理员口令>'
