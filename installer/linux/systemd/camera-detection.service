[Unit]
Description=产线缺陷在线AI检测系统 (Camera Detection System)
After=network-online.target mysql.service
# ★ 数据盘挂载完成才允许启动：/main 是数据盘挂载点，
#   盘没挂上时启动会把数据静默写进系统盘的空目录（重启后"数据全丢"）。
#   配合 /etc/fstab 中**不加 nofail**，盘挂不上则本服务启动失败——宁可报错也不静默写错盘。
RequiresMountsFor=/main
Wants=network-online.target

# 失败重启次数限制。
# 注意：StartLimitIntervalSec / StartLimitBurst 必须写在 [Unit] 段，
# 放在 [Service] 段会被 systemd 报 "Unknown key name ... in section 'Service'" 而忽略。
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=cdsys
Group=cdsys

# 工作目录：日志与上传图片的相对基准，须对 cdsys 可写
WorkingDirectory=/main/app

# 所有可变参数集中放在 /etc/default/camera-detection，改配置不动本文件
EnvironmentFile=-/etc/default/camera-detection

# 启动器负责定位 java、拼装 -Dapp.home 并 exec 启动 JVM
ExecStart=/main/app/dist/scripts/run.sh

# 与 Windows 版服务包装器一致：失败后 60 秒重启，最多连续 3 次
# （次数限制见 [Unit] 段的 StartLimitIntervalSec / StartLimitBurst）
Restart=on-failure
RestartSec=60

# 优雅停机：Spring Boot 优雅停机默认 30 秒，这里给足余量
KillSignal=SIGTERM
TimeoutStopSec=45

# 进程管理：只杀主进程，由 JVM 自己回收子进程
KillMode=mixed

# 日志：JVM stdout/stderr 进 journal，业务日志另写入 ${APP_HOME}/logs/
StandardOutput=journal
StandardError=journal
SyslogIdentifier=camera-detection

# 安全加固（不依赖内核特性，Ubuntu 22.04 默认满足）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/main/app

# 大量图片上传需要更高的文件句柄上限
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
