[Unit]
Description=产线缺陷在线AI检测系统 —— 数据库备份定时器（每日 01:00）

[Timer]
# 每日 01:00 触发
# 选这个时间的原因：
#   - 早于应用内 DataCleanupTask（02:00 的数据清理）—— 备份的是清理前的完整状态
#   - 早于图片清理（03:30）
#   - 避开夜班交接与业务高峰
OnCalendar=*-*-* 01:00:00

# 机器关机错过的任务，开机后补跑一次
Persistent=true

# 随机延迟最多 5 分钟，避免多台机器同时打备份
RandomizedDelaySec=300

Unit=camera-detection-backup.service

[Install]
WantedBy=timers.target
