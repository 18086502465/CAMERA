# ---- 构建产物 ----
target/
*.class
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar

# ---- 前端依赖与构建产物 ----
node_modules/
dist/
.vite/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 后端 static（Vite 产物副本，2026-11-13 出库）----
# 由 frontend 的 postbuild 或 build-release.sh 生成，不入库：
#   ① 产物文件名带内容哈希，每次构建 140 个文件全改名 → 提交噪音淹没真实改动；
#   ② 曾「只跟踪 51/142 个文件」→ 新 clone 得到半新半旧的 static，打出混合包；
#   ③ 历史 chunk 的版本链（KEEP_STATIC_VERSIONS）只对线上 JAR 有意义，与仓库无关。
# 打包唯一入口仍是 installer/linux/build-release.sh，它会自动完成构建+同步。
/fact-product/src/main/resources/static/

# ---- 运行时与日志 ----
logs/
*.log
runtime/
work/
*.pid
*.seed

# 本地开发时的图片上传落盘目录（运行数据，非源码）
fact-product/uploads/
uploads/

# ---- Python 缓存 ----
__pycache__/
*.pyc

# ---- 构建产物目录（由 installer/linux/build-release.sh 生成，全目录不入库）----
# 2026-11-12 收敛：此前是逐条排除 stage/tar.gz/parts/update，结果 README.md 被误跟踪
# （唯一被跟踪的 dist-release 文件），且下方 2026-11-02「发布产物全部入库」的旧决策
# 注释残留，与现状矛盾。产物完全可重现，一律不入库：
#   bash installer/linux/build-release.sh   # 全量包
#   bash installer/linux/build-release.sh --update-only   # 增量包
# 历史已入库的 exe/jar 仍在 .git 历史里（~421MB），清理需 BFG，见 docs/踩坑速查.md
dist-release/
# 构建前手工腾空 dist 时挪走的旧产物
frontend/dist.old.*

# ---- 轻量更新包产物（时间戳命名，每次构建生成，不入库）----
dist-release/linux/update/

# ---- WorkBuddy 工作区数据（非项目产物）----
.workbuddy/

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath

# ---- 系统文件 ----
Thumbs.db
.DS_Store
desktop.ini

# ---- 发布产物中的重型第三方运行时 ----
# 已被上方 `dist-release/` 整目录规则覆盖，此段仅保留决策记录：
# 内置 JRE（209MB）是第三方 OpenJDK 运行时，不是本项目代码，会随 JDK 升级失效，
# 由 build-release.ps1 现场下载 —— 任何情况下都不要入库。

