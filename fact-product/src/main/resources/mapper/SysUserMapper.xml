<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wms.iam.infra.mapper.SysUserMapper">

    <!-- 根据用户名查询用户 -->
    <select id="findByUsername" resultType="com.wms.iam.domain.model.SysUser">
        SELECT * FROM sys_user WHERE username = #{username} AND is_disabled = 0
    </select>

    <!-- 根据工厂ID查询用户列表 -->
    <select id="findByFactoryId" resultType="com.wms.iam.domain.model.SysUser">
        SELECT * FROM sys_user WHERE factory_id = #{factoryId} AND is_disabled = 0
    </select>

</mapper>
