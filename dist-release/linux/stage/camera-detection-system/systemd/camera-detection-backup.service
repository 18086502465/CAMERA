[Unit]
Description=产线缺陷在线AI检测系统 —— 数据库全量备份
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=cdsys
Group=cdsys

# 数据库口令由 /etc/default/camera-detection 提供（640 root:root）
# 不把口令写在 unit 里 —— unit 文件是全局可读的
EnvironmentFile=-/etc/default/camera-detection

ExecStart=/opt/camera-detection-system/scripts/backup-database.sh

# 备份允许的最长运行时间（按 2.6GB 库约 60s 估算，留足余量）
TimeoutStartSec=1800

# 写备份目录需要权限（若 BACKUP_DIR 指向 /data 下的路径）
ReadWritePaths=/data/camera-detection

# 失败不重试：下次 timer 触发自然会再跑，重试反而可能叠加写满磁盘
Restart=no

[Install]
WantedBy=multi-user.target
